# Backend base URL for LOCAL development (build-time; bundled into browser code — never put secrets here).
VITE_API_BASE_URL=http://127.0.0.1:8000

# Production on Render: do NOT rely on this file. Set API_BASE_URL on the "terraform-web" service instead
# (e.g. https://terraform-api.onrender.com). server.mjs serves it at runtime via /config.js.
