# TERRAFORM backend settings — copy to backend/.env for local runs.
# On Render these are set as Environment Variables on the "terraform-api" service (see render.yaml).

# ---- Optional OpenAI layer (OFF by default; the app works fully without it) ----
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_LLM_REWRITE=false
# tentative visible photo cues (needs OPENAI_API_KEY too)
ENABLE_VISION=false
OPENAI_VISION_MODEL=gpt-4.1-mini

# ---- Server ----
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Browser origin(s) allowed to call the API (comma-separated). Locally: the Vite dev server.
FRONTEND_ORIGIN=http://localhost:5173
# Optional regex for extra allowed origins (used on Render for the frontend's *.onrender.com URL)
CORS_ORIGIN_REGEX=

# ---- Paths (relative paths are resolved against backend/) ----
KB_DIRECTORY=../knowledge_base
UPLOAD_DIRECTORY=./uploads
DATA_DIRECTORY=./data
